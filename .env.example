# =============================================================================
# OBRIXEN — Variables de Entorno de Ejemplo (.env.example)
# Copia este archivo a .env para tu configuración local:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=plataforma_renta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5439

# --- Spring Boot Backend ---
DB_URL=jdbc:postgresql://localhost:5439/plataforma_renta
DB_USERNAME=postgres
DB_PASSWORD=postgres
SERVER_PORT=8080

# JWT (Clave HMAC-SHA de al menos 256 bits en hexadecimal / Base64 para desarrollo)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Documentación OpenAPI / Swagger UI (deshabilitada automáticamente en prod)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
